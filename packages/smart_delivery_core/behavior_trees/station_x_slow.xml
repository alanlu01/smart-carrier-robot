<!-- Station translation: no recovery motion, no controller selector. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="StationTranslation">
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
      <FollowPath path="{path}" controller_id="StationXSlow" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}"/>
    </Sequence>
  </BehaviorTree>
</root>
